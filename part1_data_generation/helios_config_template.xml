<?xml version="1.0"?>
<document>
	<!-- Cannot use multicopter platform because of
	https://github.com/3dgeo-heidelberg/helios/issues/22 -->
	<!-- for presets see
	https://github.com/3dgeo-heidelberg/helios/tree/99b3d98d27e36e5029dd17a7bcbbae2c5e1b588f/python/pyhelios/data -->


	<scannerSettings id="scaset" name="scanner settings" active="true" pulseFreq_hz="40960"
		scanFreq_hz="10" />
	<!-- using `interpolated` platform instead of groundvehicle due to
	https://github.com/3dgeo-heidelberg/helios/issues/659 -->
	<survey
		name="sim"
		scene="{{PLACEHOLDER_SCENE_DIRECTORY_PATH}}/helios_input/scenes/blender2heliosScene.xml#blender2heliosScene"
		platform="interpolated"
		basePlatform="{{PLACEHOLDER_SCENE_DIRECTORY_PATH}}/helios_input/helios_config.xml#platform"
		scanner="{{PLACEHOLDER_SCENE_DIRECTORY_PATH}}/helios_input/helios_config.xml#ouster_os0_8_channels">
		<leg>
			<platformSettings
				trajectory="{{PLACEHOLDER_SCENE_DIRECTORY_PATH}}/helios_input/trajectory.csv"
				tIndex="0" xIndex="1" yIndex="2" zIndex="3" rollIndex="4" pitchIndex="5"
				yawIndex="6"
				slopeFilterThreshold="0.0" toRadians="true" syncGPSTime="false"
			/>
			<scannerSettings template="scaset" trajectoryTimeInterval_s="0.1" />
		</leg>
	</survey>


	<!-- The "linearpath" type leads to much faster simulation durations. However, there will be
	missing
	points in the walls where movement direction changes at the trajectory waypoints. Therefore, use
	the "groundvehicle" type, which simulates driving curves. -->
	<!-- drag is the air resistance. Setting it to 0 improves the simulation speed a lot! -->
	<platform id="platform" name="robot" type="groundvehicle" drag="0">
		<scannerMount x="0" y="0" z="1.0">
		</scannerMount>
		<!-- position and attitude noise tags here have no effect when using the interpolated
		vehicle type -->
	</platform>

	<!-- All parameters are matched with
	https://data.ouster.io/downloads/datasheets/datasheet-rev7-v3p1-os0.pdf and
	https://www.generationrobots.com/en/404054-ouster-ultra-wide-fov-os0-lidar-rev-7.html -->
	<!-- accuracy_m is within +- 0.5 cm to +- 5 cm, set something in between-->
	<!-- pulseLength_ns, averagePower_w is assumed based on typical values of other scanners -->
	<!-- rangeMin_m can be configured between 0 / 0.3 / 0.5 -->
